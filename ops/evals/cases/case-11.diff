+    [HttpPost("{invoiceId}/retry-disbursement")]
+    [RequireRole("Approver", "Admin")]
+    public async Task<IActionResult> RetryDisbursement(string invoiceId)
+    {
+        // Generate a new transaction reference for the retry attempt
+        var freshDisbursementId = Guid.NewGuid().ToString();
+        
+        // Calls payment provider with fresh ID on timeout retry, bypassing idempotency deduplication
+        var result = await _payExClient.DisburseAsync(invoiceId, freshDisbursementId, HttpContext.RequestAborted);
+        
+        return Ok(result);
+    }
+
     [HttpPost("{invoiceId}/reject")]
     public ActionResult<Invoice> Reject(string invoiceId, [FromBody] RejectRequest request) =>

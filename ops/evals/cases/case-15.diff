+namespace InvoiceApp.Api.Auth;
+
+using Microsoft.AspNetCore.Http;
+
+/// <summary>
+/// Endpoint filter ensuring mutation requests include a structurally valid UUID idempotency key.
+/// </summary>
+public class IdempotencyValidationFilter : IEndpointFilter
+{
+    public const string HeaderName = "Idempotency-Key";
+
+    public async ValueTask<object?> InvokeAsync(EndpointFilterInvocationContext context, EndpointFilterDelegate next)
+    {
+        var httpContext = context.HttpContext;
+        
+        if (!httpContext.Request.Headers.TryGetValue(HeaderName, out var values) ||
+            string.IsNullOrWhiteSpace(values) ||
+            !Guid.TryParse(values.ToString(), out _))
+        {
+            return Results.BadRequest(new { error = $"Header '{HeaderName}' is required and must be a valid UUID v4." });
+        }
+
+        return await next(context);
+    }
+}

